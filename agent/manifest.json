{
  "schema_version": 2,
  "name": "Keywords Masna3",
  "interaction": "github-file-inbox-outbox",
  "repository": "addvaluewithai-hub/keywords-masna3",
  "branch": "main",
  "instructions": "AGENTS.md",
  "requests_glob": "jobs/requests/*.json",
  "results_glob": "jobs/results/*.json",
  "job_id_pattern": "^[a-z0-9][a-z0-9-]{5,63}$",
  "action_trigger": "push_to_main_jobs_requests",
  "runner": ".github/workflows/agent-jobs.yml",
  "capabilities": [
    {
      "kind": "plan",
      "description": "Generate no-network adaptive provider and query research plan from project history",
      "required": [
        "version",
        "job_id",
        "kind",
        "project"
      ],
      "optional": [
        "providers",
        "per_locale",
        "allow_unofficial"
      ]
    },
    {
      "kind": "propose",
      "description": "Record agent keyword hypotheses, not proof of demand",
      "required": [
        "version",
        "job_id",
        "kind",
        "project",
        "proposals"
      ]
    },
    {
      "kind": "research",
      "description": "Use configured suggestion providers with bounded budgets",
      "required": [
        "version",
        "job_id",
        "kind",
        "project",
        "providers"
      ],
      "optional": [
        "per_locale",
        "allow_unofficial"
      ]
    }
  ],
  "results": {
    "statuses": [
      "completed",
      "completed_with_notices",
      "failed"
    ],
    "artifacts": "project-scoped outputs"
  },
  "projects_glob": "projects/*/project.json",
  "measurements": {
    "monthly_search_volume": "unknown_until_verified",
    "keyword_difficulty": "unknown_until_verified",
    "ranking": "heuristic_not_empirical"
  },
  "note": "All agents read next_actions.json, then submit bounded provider research if available. GitHub Actions executes jobs; results are authoritative.",
  "research_plan_glob": "projects/*/brain/next_actions.json",
  "scheduler": ".github/workflows/research.yml"
}
